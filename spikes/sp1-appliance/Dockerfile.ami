# SP1/SP4 spike AMI: Ubuntu 24.04 as a system container (ADR-0004).
#
# THROWAWAY. The real AMI pipeline lands in M2 under images/amis/ubuntu-24.04/.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV container=podman

RUN apt-get update && apt-get install -y --no-install-recommends \
        systemd \
        systemd-sysv \
        dbus \
        openssh-server \
        sudo \
        cloud-init \
        iproute2 \
        iputils-ping \
        nftables \
        ufw \
        curl \
        ca-certificates \
        less \
        vim-tiny \
        nginx \
    && systemctl disable nginx \
    && rm -rf /var/lib/apt/lists/*

# ADR-0004 validation 2 asks whether `systemctl start nginx` works inside a
# system container. nginx is installed here, at build time, so the check itself
# runs OFFLINE: every SP1 instance has --network none, because giving an
# instance a network is SP2's job and Nephos never uses a Podman network to
# model one. Keeping a cached .deb lets the apt path be exercised offline too.
RUN apt-get update \
 && mkdir -p /opt/nephos-spike \
 && cd /opt/nephos-spike \
 && apt-get download hello 2>/dev/null || true \
 && rm -rf /var/lib/apt/lists/*

# RISKS T2: units that expect real hardware fail in a container and slow the
# boot. Mask them rather than letting them fail, so that a genuinely failed unit
# in the SP1 report means something.
RUN systemctl mask \
        systemd-udevd.service \
        systemd-udev-trigger.service \
        systemd-udevd-kernel.socket \
        systemd-udevd-control.socket \
        systemd-modules-load.service \
        systemd-timesyncd.service \
        systemd-random-seed.service \
        systemd-firstboot.service \
        sys-kernel-debug.mount \
        sys-kernel-config.mount \
        sys-kernel-tracing.mount \
        dev-hugepages.mount \
        e2scrub_reap.service \
 && rm -f /lib/systemd/system/multi-user.target.wants/systemd-resolved.service

# cloud-init reads its metadata from the Nephos IMDS at 169.254.169.254
# (ARCHITECTURE section 5.1). strict_id is off because Nephos is not EC2 and
# carries no EC2 instance identity document.
RUN printf '%s\n' \
    'datasource_list: [ Ec2, None ]' \
    'datasource:' \
    '  Ec2:' \
    '    metadata_urls: [ "http://169.254.169.254" ]' \
    '    strict_id: false' \
    '    timeout: 1' \
    '    max_wait: 3' \
    > /etc/cloud/cloud.cfg.d/90-nephos.cfg
# cloud-init's stock timeouts (max_wait 120) are sized for a real cloud. Nephos
# serves IMDS from the instance's own VPC router, so a reachable service answers
# in well under a millisecond and an unreachable one should cost seconds, not
# minutes. SP1 measured boot-to-sshd rising from 1.2 s to 10.9 s purely because
# instances there have no network and cloud-init sat out its metadata wait.

# ds-identify runs before cloud-init and decides whether to run it at all. In a
# container it finds no recognised platform and reports "disabled", so
# cloud-init never even looks at the datasource above and `cloud-init status`
# answers "disabled". Nephos instances ARE containers by design (ADR-0004), so
# this would disable user data and key injection on every instance.
#
# Forcing the policy to enabled is the documented escape hatch. RISKS T2 in
# concrete form.
RUN printf 'policy: enabled,found=all,maybe=all,notfound=enabled\n' \
      > /etc/cloud/ds-identify.cfg \
 && rm -f /etc/cloud/cloud-init.disabled \
 && systemctl enable cloud-init-local.service cloud-init.service \
                     cloud-config.service cloud-final.service

# cc_install_hotplug runs `udevadm control --reload-rules`, which fails because
# udev is masked above — and one failing module makes `cloud-init status` report
# `error` even though user data ran and the SSH key was installed. Device
# hotplug is meaningless in a container, so the module is dropped.
#
# The module list is edited in /etc/cloud/cloud.cfg itself, NOT added as a
# cloud.cfg.d overlay: cloud-init merges lists by appending, so an overlay
# leaves the original entry in place and the module still runs.
# install_hotplug lives in cloud_final_modules on Ubuntu 24.04, not
# cloud_config_modules, so every module list is filtered rather than a guessed
# one. The grep at the end makes the build fail if it is still there.
RUN python3 -c "\
import yaml;\
path = '/etc/cloud/cloud.cfg';\
cfg = yaml.safe_load(open(path));\
name = lambda m: m if isinstance(m, str) else (m[0] if isinstance(m, list) else m.get('name'));\
drop = {'install_hotplug'};\
keys = ['cloud_init_modules', 'cloud_config_modules', 'cloud_final_modules'];\
[cfg.__setitem__(k, [m for m in cfg.get(k, []) if name(m) not in drop]) for k in keys if k in cfg];\
open(path, 'w').write(yaml.safe_dump(cfg, default_flow_style=False))" \
 && rm -f /etc/cloud/cloud.cfg.d/92-nephos-container.cfg \
 && ! grep -q install_hotplug /etc/cloud/cloud.cfg

# apt drops privileges to the _apt user, which needs setgroups. Inside a user
# namespace that call returns EINVAL and every apt operation fails with
# "setgroups 65534 failed". Instances run with userns=auto by design
# (ADR-0004 R2), so the sandbox has to be turned off for apt to work at all.
RUN printf 'APT::Sandbox::User "root";\n' > /etc/apt/apt.conf.d/99-nephos-userns

# Key-only SSH, no default passwords (RISKS S4).
RUN mkdir -p /etc/ssh/sshd_config.d \
 && printf '%s\n' \
    'PasswordAuthentication no' \
    'PermitRootLogin no' \
    'UseDNS no' \
    > /etc/ssh/sshd_config.d/10-nephos.conf \
 && systemctl enable ssh

# sshd needs host keys before its first start. Baking them into the image would
# give every instance identical keys, so they are generated on first boot by an
# ExecStartPre (ssh-keygen -A is idempotent and only writes what is missing).
#
# Socket activation is deliberately turned off in favour of a plain long-running
# sshd. Under ssh.socket, systemd binds :22 immediately and starts ssh.service
# only when a connection arrives — so the port is open within milliseconds even
# if sshd later fails outright. A real EC2 instance runs sshd as a daemon, and
# Nephos should not invent a readiness signal that can lie.
RUN rm -f /etc/ssh/ssh_host_* \
 && mkdir -p /etc/systemd/system/ssh.service.d \
    && printf '%s\n' \
    '[Service]' \
    '# Ubuntu ships ExecStartPre=/usr/sbin/sshd -t. Drop-ins APPEND, so without' \
    '# the empty assignment that validity check runs first and fails with' \
    '# "no hostkeys available" before the keys have been generated.' \
    'ExecStartPre=' \
    'ExecStartPre=/usr/bin/ssh-keygen -A' \
    'ExecStartPre=/usr/sbin/sshd -t' \
    > /etc/systemd/system/ssh.service.d/10-nephos-hostkeys.conf \
 && systemctl disable ssh.socket \
 && systemctl enable ssh.service

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
